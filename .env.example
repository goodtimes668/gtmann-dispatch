# Slack notifications are optional. Configure these in Netlify, never in Git.
DISPATCH_SLACK_BOT_TOKEN=
BRENT_SLACK_ID=
SLACK_MANAGER_CHANNEL_ID=
DISPATCH_APP_URL=https://gtmann-dispatch.netlify.app/

# Set before inviting the first user. That email receives the manager role.
BOOTSTRAP_MANAGER_EMAIL=owner@example.com

# Optional. Enables live driving routes from Faithwood Farms. Without it,
# selected address coordinates use a clearly labelled approximate road route.
MAPBOX_ACCESS_TOKEN=
